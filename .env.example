# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==============================================================================
# BACKEND API (server/) — App Owner module, subdomain tenancy, auth, email
# ==============================================================================

# DATABASE_URL: Postgres connection string (Supabase). Required by server/db/client.ts
# and drizzle.config.ts. See docs/DATABASE_SETUP.md.
DATABASE_URL="postgresql://user:password@host:6543/postgres"

# APP_BASE_DOMAIN: the bare domain App Owner logs in on; every tenant lives on
# "{subdomain}.APP_BASE_DOMAIN". Dev: "localhost:3000" (no /etc/hosts needed,
# *.localhost resolves automatically). Production: e.g. "hrms.com".
APP_BASE_DOMAIN="localhost:3000"

# JWT_SECRET: signs the session cookie (App Owner + tenant admin login).
JWT_SECRET="change-me-to-a-long-random-string"

# API_PORT: port the Express API listens on (default 4000).
API_PORT="4000"

# RESEND_API_KEY: from your resend.com account. Used server-side only
# (server/lib/email.ts) — never exposed to the frontend or stored in the DB.
RESEND_API_KEY="re_xxx"
# RESEND_FROM_EMAIL: verified sender address/display name in Resend.
RESEND_FROM_EMAIL="NusaHR <onboarding@resend.dev>"

# APP_OWNER_SEED_EMAIL / APP_OWNER_SEED_PASSWORD: only used once by
# `npm run db:seed` to create the first App Owner login. Change the password
# after first login; these vars aren't read anywhere else.
APP_OWNER_SEED_EMAIL="owner@nusahr.local"
APP_OWNER_SEED_PASSWORD="ChangeMe123!"
